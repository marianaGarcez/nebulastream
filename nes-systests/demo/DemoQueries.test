# name: demo/DemoQueries.test
# description: The eight SIGMOD 2025 demo queries expressed with Leo's DataType plugins, over a real SNCB slice. References are the old-API originals in nebulastream-private/nes-plugins/meos/tests/Integration/MeosSNCBQuery{1..8}.cpp.
# groups: [Demo, GeoTemporal, Meos]

# ---------------------------------------------------------------------------
# Data: a contiguous two-hour slice (1722657600..1722664800) of the SNCB dataset the
# demo itself used (M6_data_csv/selected_columns_df_original.csv, 4.1M rows). Every
# query below reads this one slice.
#
# The slice was chosen because it contains both event classes the demo needs:
#   1683 rows, 4 devices, 29 rows with gps_speed < 0.002 (Q7), 307 with code1 > 0 (Q8).
#
# Geography in this slice:
#   device 1  moving, lat 51.03..51.34, lon 3.20..3.71   (West Flanders)
#   device 4  moving, lat 50.84..51.20, lon 3.22..4.20
#   device 3  parked, lat 51.2245,      lon 4.4415       (Antwerp workshop)
#   device 5  parked, lat 50.4196,      lon 4.5349       (Charleroi workshop)
# ---------------------------------------------------------------------------
CREATE LOGICAL SOURCE sncb_stream(ts UINT64 NOT NULL, deviceid UINT64 NOT NULL, vbat FLOAT64 NOT NULL, pcfa_mbar FLOAT64 NOT NULL, pcff_mbar FLOAT64 NOT NULL, pcf1_mbar FLOAT64 NOT NULL, pcf2_mbar FLOAT64 NOT NULL, t1_mbar FLOAT64 NOT NULL, t2_mbar FLOAT64 NOT NULL, code1 FLOAT64 NOT NULL, code2 FLOAT64 NOT NULL, gsp_speed FLOAT64 NOT NULL, gps_lat FLOAT64 NOT NULL, gps_lon FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR sncb_stream TYPE FILE;
ATTACH FILE small/sncb_demo.csv

# ===========================================================================
# Q1 — Location-Based Alert Filtering
# Reference: MeosSNCBQuery1.cpp
#   .filter(teintersects(lon, lat, ts) == 1 && (Code1 != 0 || Code2 != 0))
#   .window(SlidingWindow) .apply(Avg(speed))
# The demo's teintersects carried its geometry inside the operator; the operational
# area is a lon/lat rectangle, so it lifts to an explicit SpatioTemporalBox.
# ===========================================================================
SELECT start, end, AVG(gsp_speed) AS avg_speed FROM sncb_stream WHERE tgeo_at_stbox(MovingPoint(gps_lon, gps_lat, ts), SpatioTemporalBox(FLOAT64(3.0), FLOAT64(4.0), FLOAT64(50.8), FLOAT64(51.4), UINT64(1722657600), UINT64(1722664800))) AND (code1 != FLOAT64(0.0) OR code2 != FLOAT64(0.0)) WINDOW SLIDING(ts, SIZE 600 ms, ADVANCE BY 300 ms) INTO FILE('CSV' as `SINK`.OUTPUT_FORMAT);
----
1722657300,1722657900,0.022326
1722657600,1722658200,0.021642
1722657900,1722658500,4.165962
1722658200,1722658800,4.863283
1722658500,1722659100,0.58784
1722658800,1722659400,0.02318
1722659100,1722659700,10.041776
1722659400,1722660000,33.835469
1722659700,1722660300,46.600103
1722660000,1722660600,29.754176
1722660300,1722660900,9.529305
1722660600,1722661200,2.834509
1722660900,1722661500,0.01937
1722661200,1722661800,1.529542
1722661500,1722662100,29.074917
1722661800,1722662400,64.256805
1722662100,1722662700,71.253856
1722662400,1722663000,85.366521
