# ---------------------------------------------------------------------------
# Probe 4: join semantics, the Q3/Q4/Q8 shape — two streams joined on the
# event timestamp inside a tumbling window.
# ---------------------------------------------------------------------------
SELECT * FROM (SELECT * FROM sncb_stream) INNER JOIN (SELECT * FROM zone_stream) ON deviceid = zid WINDOW TUMBLING(ts, SIZE 100 ms) INTO FILE('CSV' as `SINK`.OUTPUT_FORMAT);
