# ---------------------------------------------------------------------------
# Probe 6: the demo's literal join key — equality on the event timestamp
# (Q3/Q4/Q8 used .where(timestamp == other$timestamp)). Uses the duplicated
# zts field, since a bare `ts` is ambiguous across both inputs.
# ---------------------------------------------------------------------------
SELECT * FROM (SELECT * FROM sncb_stream) INNER JOIN (SELECT * FROM zone_stream) ON ts = zts WINDOW TUMBLING(ts, SIZE 100 ms) INTO FILE('CSV' as `SINK`.OUTPUT_FORMAT);
