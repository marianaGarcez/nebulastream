# ---------------------------------------------------------------------------
# Probe 5: join with a MEOS predicate on one side, as Q8 does
# (geofence filter joined against a pressure-threshold subquery).
# ---------------------------------------------------------------------------
SELECT * FROM (SELECT * FROM sncb_stream WHERE tgeo_at_stbox(MovingPoint(gps_lon, gps_lat, ts), SpatioTemporalBox(FLOAT64(4.0), FLOAT64(4.6), FLOAT64(50.0), FLOAT64(50.8), UINT64(1722470400), UINT64(1754006400)))) INNER JOIN (SELECT * FROM zone_stream) ON deviceid = zid WINDOW TUMBLING(ts, SIZE 100 ms) INTO FILE('CSV' as `SINK`.OUTPUT_FORMAT);
