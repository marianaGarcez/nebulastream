# name: demo/Phase0.test
# description: Phase 0 de-risking for the SIGMOD demo port. Probes JSON sink shape, the Q2 query shape, workshop-box disjunction (Q7), and join semantics (Q3/Q4/Q8).
# groups: [Demo, GeoTemporal, Meos]

CREATE LOGICAL SOURCE sncb_stream(ts UINT64 NOT NULL, deviceid UINT64 NOT NULL, vbat FLOAT64 NOT NULL, pcfa_mbar FLOAT64 NOT NULL, pcff_mbar FLOAT64 NOT NULL, pcf1_mbar FLOAT64 NOT NULL, pcf2_mbar FLOAT64 NOT NULL, t1_mbar FLOAT64 NOT NULL, t2_mbar FLOAT64 NOT NULL, code1 FLOAT64 NOT NULL, code2 FLOAT64 NOT NULL, gsp_speed FLOAT64 NOT NULL, gps_lat FLOAT64 NOT NULL, gps_lon FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR sncb_stream TYPE FILE;
ATTACH FILE small/input_sncb.csv

# A second stream standing in for the highriskArea / weather side of the Q3, Q4 and Q8
# joins. Note ts is named identically to sncb_stream.ts: the window timestamp must be
# resolvable in BOTH join inputs (cf. guide/guide11.test), while zts carries a copy for
# use as an explicit join key.
CREATE LOGICAL SOURCE zone_stream(ts UINT64 NOT NULL, zts UINT64 NOT NULL, zid UINT64 NOT NULL, zlimit FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR zone_stream TYPE FILE;
ATTACH INLINE
1722520348,1722520348,3,15.0
1722520358,1722520358,3,15.0
1722520368,1722520368,3,15.0
1722520428,1722520428,5,25.0
1722520439,1722520439,5,25.0

# ---------------------------------------------------------------------------
# Probe 1: JSON sink shape and field naming, as consumed by NebulaMEOSVisu.
# ---------------------------------------------------------------------------
SELECT ts, deviceid, gps_lat, gps_lon, gsp_speed FROM sncb_stream WHERE ts == UINT64(1722520348) INTO FILE('JSON' as `SINK`.OUTPUT_FORMAT);
----
{"SNCB_STREAM$TS":1722520348,"SNCB_STREAM$DEVICEID":3,"SNCB_STREAM$GPS_LAT":50.6456,"SNCB_STREAM$GPS_LON":4.3658,"SNCB_STREAM$GSP_SPEED":1.4671}
{"SNCB_STREAM$TS":1722520348,"SNCB_STREAM$DEVICEID":5,"SNCB_STREAM$GPS_LAT":51.3001,"SNCB_STREAM$GPS_LON":4.4325,"SNCB_STREAM$GSP_SPEED":94.9161}

# ---------------------------------------------------------------------------
# Probe 2: Q2 (Noise Monitoring) shape — tgeo_at_stbox + arithmetic filter
# + tumbling window + Max. This is the proposed Phase 1 query.
# ---------------------------------------------------------------------------
SELECT start, end, MAX(pcfa_mbar) AS max_pcfa FROM sncb_stream WHERE tgeo_at_stbox(MovingPoint(gps_lon, gps_lat, ts), SpatioTemporalBox(FLOAT64(4.0), FLOAT64(4.6), FLOAT64(50.0), FLOAT64(50.8), UINT64(1722470400), UINT64(1754006400))) AND gsp_speed > FLOAT64(0.0) AND pcfa_mbar > FLOAT64(0.0) AND gsp_speed * FLOAT64(0.5) + pcfa_mbar * FLOAT64(0.5) > FLOAT64(2.0) WINDOW TUMBLING(ts, size 500 ms) INTO FILE('CSV' as `SINK`.OUTPUT_FORMAT);
----
1722520000,1722520500,4.983

# ---------------------------------------------------------------------------
# Probe 3: Q7 workshop containment expressed as a disjunction of
# tgeo_at_stbox over SpatioTemporalBox constants, replacing tpointatsworkshop.
# ---------------------------------------------------------------------------
SELECT ts, deviceid, gps_lat, gps_lon FROM sncb_stream WHERE tgeo_at_stbox(MovingPoint(gps_lon, gps_lat, ts), SpatioTemporalBox(FLOAT64(4.3), FLOAT64(4.4), FLOAT64(50.6), FLOAT64(50.7), UINT64(1722470400), UINT64(1754006400))) OR tgeo_at_stbox(MovingPoint(gps_lon, gps_lat, ts), SpatioTemporalBox(FLOAT64(4.4), FLOAT64(4.5), FLOAT64(51.2), FLOAT64(51.4), UINT64(1722470400), UINT64(1754006400))) INTO FILE('CSV' as `SINK`.OUTPUT_FORMAT);
