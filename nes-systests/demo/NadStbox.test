# name: demo/NadStbox.test
# description: nad_tgeo_stbox — nearest approach distance between a MovingPoint and a SpatioTemporalBox. Typed counterpart of the demo's distancetpointstbox (Q5).
# groups: [Demo, GeoTemporal, Meos]

CREATE LOGICAL SOURCE sncb_stream(ts UINT64 NOT NULL, deviceid UINT64 NOT NULL, vbat FLOAT64 NOT NULL, pcfa_mbar FLOAT64 NOT NULL, pcff_mbar FLOAT64 NOT NULL, pcf1_mbar FLOAT64 NOT NULL, pcf2_mbar FLOAT64 NOT NULL, t1_mbar FLOAT64 NOT NULL, t2_mbar FLOAT64 NOT NULL, code1 FLOAT64 NOT NULL, code2 FLOAT64 NOT NULL, gsp_speed FLOAT64 NOT NULL, gps_lat FLOAT64 NOT NULL, gps_lon FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR sncb_stream TYPE FILE;
ATTACH FILE small/input_sncb.csv

# Distance from each point to a box around the device-3 area. Points inside must read 0.
SELECT ts, deviceid, nad_tgeo_stbox(MovingPoint(gps_lon, gps_lat, ts), SpatioTemporalBox(FLOAT64(4.3), FLOAT64(4.4), FLOAT64(50.6), FLOAT64(50.7), UINT64(1722470400), UINT64(1754006400))) AS dist FROM sncb_stream WHERE ts < UINT64(1722520370) INTO FILE('CSV' as `SINK`.OUTPUT_FORMAT);
----
1722520348,3,0.0
1722520348,5,0.600979
1722520358,3,0.0
1722520358,5,0.603239
1722520368,3,0.0
1722520368,5,0.605699
